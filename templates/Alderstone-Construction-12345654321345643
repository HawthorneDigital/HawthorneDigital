
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#141719">
<meta name="description" content="Alderstone Construction. Modern construction, property development, extensions and commercial building solutions.">
<title>Alderstone Construction | Built for Tomorrow</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{
    --dark:#141719;
    --black:#0C0E10;
    --orange:#F5A623;
    --white:#FFFFFF;
    --light:#F4F4F0;
    --muted:#71777C;
    --border:#DFE1DF;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
    scroll-padding-top:100px;
}

body{
    font-family:'Manrope',sans-serif;
    background:var(--light);
    color:var(--dark);
    line-height:1.7;
    overflow-x:hidden;
}

h1,h2,h3,h4{
    font-family:'Space Grotesk',sans-serif;
    line-height:1.1;
}

a{
    color:inherit;
    text-decoration:none;
}

button,input,textarea,select{
    font:inherit;
}

button{
    cursor:pointer;
}

img{
    display:block;
    width:100%;
    object-fit:cover;
}

.container{
    width:min(1320px,90%);
    margin:auto;
}

.section{
    padding:100px 0;
}

.eyebrow{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:11px;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.eyebrow::before{
    content:"";
    width:9px;
    height:9px;
    background:var(--orange);
}

.section-title{
    font-size:clamp(35px,4.5vw,64px);
    letter-spacing:-2.5px;
    font-weight:700;
}

.section-description{
    color:var(--muted);
    max-width:600px;
    font-size:15px;
    margin-top:20px;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:30px;
    padding:16px 25px;
    border:1px solid transparent;
    font-size:13px;
    font-weight:800;
    transition:.25s;
}

.btn-primary{
    background:var(--orange);
    color:var(--black);
}

.btn-primary:hover{
    background:#FFC15B;
    transform:translateY(-3px);
}

.btn-outline{
    color:white;
    border-color:rgba(255,255,255,.4);
}

.btn-outline:hover{
    background:white;
    color:var(--dark);
}

.btn-dark{
    background:var(--dark);
    color:white;
}

.btn-dark:hover{
    background:var(--orange);
    color:var(--dark);
}

/* TOP BAR */

.topbar{
    background:var(--black);
    color:#B9BFC3;
    font-size:11px;
    padding:10px 0;
}

.topbar-inner{
    display:flex;
    justify-content:space-between;
    gap:20px;
}

.topbar-right{
    display:flex;
    gap:25px;
}

/* NAVIGATION */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:var(--dark);
    color:white;
    border-bottom:1px solid rgba(255,255,255,.1);
}

.nav-inner{
    min-height:85px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    flex-shrink:0;
}

.brand-icon{
    width:42px;
    height:42px;
    color:var(--orange);
}

.brand-name{
    font-family:'Space Grotesk',sans-serif;
    font-size:22px;
    font-weight:700;
    letter-spacing:1px;
    line-height:1;
}

.brand-name small{
    display:block;
    font-family:'Manrope',sans-serif;
    font-size:9px;
    letter-spacing:4px;
    font-weight:700;
    margin-top:7px;
}

nav{
    display:flex;
    align-items:center;
    gap:30px;
}

nav a{
    font-size:12px;
    font-weight:700;
    transition:color .2s;
}

nav a:hover{
    color:var(--orange);
}

.menu-toggle{
    display:none;
    background:none;
    color:white;
    border:1px solid #555;
    padding:8px 13px;
    font-size:22px;
}

/* HERO */

.hero{
    min-height:690px;
    position:relative;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        linear-gradient(
            90deg,
            rgba(12,14,16,.96),
            rgba(12,14,16,.75) 40%,
            rgba(12,14,16,.18) 100%
        ),
        url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=2200&q=85')
        center/cover;
    color:white;
}

.hero::before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:65px 65px;
    pointer-events:none;
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:850px;
    padding:90px 0 130px;
}

.hero .eyebrow{
    color:var(--orange);
}

.hero h1{
    font-size:clamp(55px,7.6vw,110px);
    letter-spacing:-5px;
    line-height:.98;
    font-weight:700;
}

.hero h1 span{
    color:var(--orange);
}

.hero p{
    font-size:17px;
    color:#D2D6D9;
    max-width:580px;
    margin:28px 0 35px;
}

.hero-actions{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
}

.hero-index{
    position:absolute;
    right:5%;
    bottom:45px;
    display:flex;
    align-items:center;
    gap:15px;
    font-family:'Space Grotesk',sans-serif;
    color:#DDD;
    font-size:12px;
}

.hero-index span{
    display:block;
    width:80px;
    height:1px;
    background:var(--orange);
}

/* CAPABILITIES STRIP */

.capability-strip{
    background:var(--orange);
    color:var(--dark);
}

.capability-inner{
    display:grid;
    grid-template-columns:repeat(4,1fr);
}

.capability{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:24px 12px;
    font-size:12px;
    font-weight:800;
    border-right:1px solid rgba(0,0,0,.15);
}

.capability:last-child{
    border-right:0;
}

.capability svg{
    width:22px;
    height:22px;
    flex-shrink:0;
}

/* SERVICES */

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:35px;
    margin-bottom:45px;
}

.services-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:18px;
}

.service-card{
    position:relative;
    background:white;
    border:1px solid var(--border);
    min-height:290px;
    padding:32px;
    display:flex;
    flex-direction:column;
    transition:background .3s,color .3s,transform .3s;
}

.service-card:hover{
    background:var(--dark);
    color:white;
    transform:translateY(-5px);
}

.service-number{
    position:absolute;
    right:25px;
    top:25px;
    font-family:'Space Grotesk',sans-serif;
    font-size:12px;
    color:var(--muted);
}

.service-icon{
    width:54px;
    height:54px;
    background:#FFF2DC;
    color:#A96800;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:30px;
}

.service-icon svg{
    width:28px;
    height:28px;
}

.service-card h3{
    font-size:24px;
    letter-spacing:-.6px;
    margin-bottom:13px;
}

.service-card p{
    color:var(--muted);
    font-size:13px;
    margin-bottom:25px;
}

.service-card:hover p{
    color:#B9BFC3;
}

.service-link{
    margin-top:auto;
    font-size:12px;
    font-weight:800;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.service-link span{
    font-size:21px;
    color:#A96800;
}

.service-card:hover .service-link span{
    color:var(--orange);
}

/* ABOUT */

.about{
    background:var(--dark);
    color:white;
    overflow:hidden;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    min-height:580px;
}

.about-image{
    position:relative;
    min-height:500px;
}

.about-image img{
    position:absolute;
    inset:0;
    height:100%;
}

.image-label{
    position:absolute;
    bottom:25px;
    left:25px;
    background:var(--orange);
    color:var(--dark);
    padding:18px 24px;
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:18px;
}

.about-content{
    padding:75px 9%;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.about-content .eyebrow{
    color:var(--orange);
}

.about-content h2{
    font-size:clamp(35px,4vw,60px);
    letter-spacing:-2px;
}

.about-content p{
    color:#B9BFC3;
    font-size:14px;
    margin-top:22px;
}

.about-features{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
    margin:30px 0;
}

.about-feature{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:12px;
    font-weight:700;
}

.about-feature span{
    color:var(--orange);
    font-size:17px;
}

.about-content .btn{
    align-self:flex-start;
}

/* PROJECTS */

.projects-grid{
    display:grid;
    grid-template-columns:1.25fr 1fr;
    grid-template-rows:260px 260px;
    gap:18px;
}

.project{
    position:relative;
    overflow:hidden;
    background:var(--dark);
    color:white;
}

.project:first-child{
    grid-row:span 2;
}

.project img{
    height:100%;
    transition:transform .65s;
}

.project:hover img{
    transform:scale(1.06);
}

.project::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        transparent 20%,
        rgba(0,0,0,.85)
    );
}

.project-info{
    position:absolute;
    z-index:2;
    bottom:0;
    left:0;
    right:0;
    padding:30px;
}

.project-info span{
    font-size:10px;
    font-weight:800;
    letter-spacing:1.5px;
    color:var(--orange);
    text-transform:uppercase;
}

.project-info h3{
    font-size:clamp(23px,3vw,36px);
    margin-top:8px;
}

.project-info p{
    color:#DDD;
    font-size:12px;
    margin-top:8px;
}

.project-arrow{
    position:absolute;
    top:20px;
    right:20px;
    z-index:3;
    width:40px;
    height:40px;
    background:var(--orange);
    color:var(--dark);
    display:grid;
    place-items:center;
    font-size:22px;
}

/* PROCESS */

.process{
    background:#E8EAE7;
    border-top:1px solid var(--border);
}

.process-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    margin-top:50px;
}

.process-step{
    position:relative;
    padding:25px 25px 25px 0;
    border-top:2px solid #C9CDCA;
}

.process-step::before{
    content:"";
    position:absolute;
    top:-5px;
    left:0;
    width:9px;
    height:9px;
    background:var(--orange);
}

.step-number{
    font-family:'Space Grotesk',sans-serif;
    font-size:48px;
    color:#747B78;
    line-height:1;
    margin-bottom:25px;
}

.process-step h3{
    font-size:23px;
    margin-bottom:12px;
}

.process-step p{
    color:var(--muted);
    font-size:13px;
}

/* FAQ */

.faq-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:80px;
}

details{
    border-bottom:1px solid var(--border);
    padding:22px 0;
}

summary{
    list-style:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    font-weight:800;
    font-size:15px;
    cursor:pointer;
}

summary::-webkit-details-marker{
    display:none;
}

summary::after{
    content:"+";
    font-size:25px;
    color:#A96800;
}

details[open] summary::after{
    content:"−";
}

details p{
    color:var(--muted);
    font-size:14px;
    padding:15px 25px 0 0;
}

/* CONTACT */

.contact{
    background:var(--dark);
    color:white;
    position:relative;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:80px;
    align-items:center;
}

.contact .eyebrow{
    color:var(--orange);
}

.contact-copy h2{
    font-size:clamp(40px,5vw,75px);
    letter-spacing:-3px;
}

.contact-copy h2 span{
    color:var(--orange);
}

.contact-copy p{
    color:#B9BFC3;
    margin:25px 0;
    max-width:470px;
    font-size:15px;
}

.contact-detail{
    padding:20px 0;
    border-bottom:1px solid rgba(255,255,255,.12);
}

.contact-detail small{
    display:block;
    color:#AEB5B9;
    font-size:11px;
    margin-bottom:5px;
}

.contact-detail strong{
    font-size:17px;
}

.contact-form{
    background:white;
    color:var(--dark);
    padding:35px;
}

.contact-form h3{
    font-size:27px;
    margin-bottom:8px;
}

.form-intro{
    font-size:13px;
    color:var(--muted);
    margin-bottom:25px;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.field{
    margin-bottom:15px;
}

.field label{
    display:block;
    font-size:12px;
    font-weight:800;
    margin-bottom:7px;
}

.field input,
.field select,
.field textarea{
    width:100%;
    padding:13px;
    border:1px solid var(--border);
    background:#F6F7F5;
    color:var(--dark);
    font-size:13px;
    border-radius:0;
}

.field textarea{
    min-height:110px;
    resize:vertical;
}

.contact-form .btn{
    width:100%;
}

.form-notice{
    margin-top:15px;
    font-size:11px;
    color:var(--muted);
}

#formMessage{
    padding:15px;
    margin-top:15px;
    background:#FFF2DC;
    color:#765000;
    font-size:13px;
}

[hidden]{
    display:none!important;
}

/* FOOTER */

footer{
    background:var(--black);
    color:white;
    padding:65px 0 25px;
}

.footer-grid{
    display:grid;
    grid-template-columns:1.6fr 1fr 1fr 1fr;
    gap:45px;
}

.footer-brand p{
    font-size:13px;
    color:#969EA4;
    margin-top:22px;
    max-width:300px;
}

.footer-col h4{
    font-size:15px;
    margin-bottom:22px;
}

.footer-col a,
.footer-col p{
    display:block;
    color:#969EA4;
    font-size:12px;
    margin-bottom:12px;
}

.footer-col a:hover{
    color:var(--orange);
}

.footer-bottom{
    display:flex;
    justify-content:space-between;
    gap:20px;
    flex-wrap:wrap;
    border-top:1px solid #292D30;
    margin-top:50px;
    padding-top:23px;
    color:#969EA4;
    font-size:11px;
}

.footer-bottom a{
    color:var(--orange);
}

/* ANIMATIONS */

.reveal{
    transition:opacity .7s ease,transform .7s ease;
}

.js .reveal{
    opacity:0;
    transform:translateY(25px);
}

.js .reveal.visible{
    opacity:1;
    transform:translateY(0);
}

:focus-visible{
    outline:3px solid var(--orange);
    outline-offset:4px;
}

/* RESPONSIVE */

@media(max-width:1050px){

    nav{
        gap:18px;
    }

    .nav-inner > .btn{
        display:none;
    }

    .services-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .contact-grid{
        gap:35px;
    }

    .footer-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:800px){

    .section{
        padding:65px 0;
    }

    .topbar-right{
        display:none;
    }

    .topbar-inner{
        justify-content:center;
        text-align:center;
    }

    .menu-toggle{
        display:block;
    }

    .nav-inner{
        min-height:75px;
    }

    nav{
        display:none;
        position:absolute;
        top:100%;
        left:0;
        right:0;
        padding:20px 5%;
        background:var(--dark);
        border-top:1px solid #333;
        flex-direction:column;
        align-items:stretch;
        gap:0;
    }

    nav.open{
        display:flex;
    }

    nav a{
        padding:15px 0;
        border-bottom:1px solid #333;
    }

    .hero{
        min-height:600px;
        background-position:65% center;
    }

    .hero h1{
        letter-spacing:-3px;
    }

    .hero-content{
        padding:70px 0 100px;
    }

    .capability-inner{
        grid-template-columns:repeat(2,1fr);
    }

    .capability{
        border-bottom:1px solid rgba(0,0,0,.15);
    }

    .section-heading{
        flex-direction:column;
        align-items:flex-start;
    }

    .about-grid,
    .contact-grid,
    .faq-grid{
        grid-template-columns:1fr;
    }

    .about-image{
        min-height:380px;
    }

    .about-content{
        padding:50px 5%;
    }

    .projects-grid{
        grid-template-columns:1fr;
        grid-template-rows:auto;
    }

    .project,
    .project:first-child{
        grid-row:auto;
        height:350px;
    }

    .process-grid{
        grid-template-columns:repeat(2,1fr);
        row-gap:30px;
    }

    .faq-grid{
        gap:25px;
    }

}

@media(max-width:500px){

    .brand-name{
        font-size:18px;
    }

    .brand-name small{
        font-size:8px;
        letter-spacing:3px;
    }

    .brand-icon{
        width:35px;
        height:35px;
    }

    .hero{
        min-height:560px;
    }

    .hero h1{
        font-size:53px;
        letter-spacing:-2.5px;
    }

    .hero p{
        font-size:14px;
    }

    .hero-actions .btn{
        width:100%;
    }

    .services-grid,
    .form-row,
    .footer-grid{
        grid-template-columns:1fr;
    }

    .service-card{
        min-height:250px;
        padding:25px;
    }

    .capability{
        font-size:10px;
        gap:7px;
        padding:18px 7px;
    }

    .project,
    .project:first-child{
        height:300px;
    }

    .project-info{
        padding:22px;
    }

    .process-step{
        padding-right:15px;
    }

    .process-step h3{
        font-size:20px;
    }

    .contact-form{
        padding:24px;
    }

    .footer-grid{
        gap:25px;
    }

}

@media(prefers-reduced-motion:reduce){

    html{
        scroll-behavior:auto;
    }

    *,*::before,*::after{
        transition:none!important;
    }

    .js .reveal{
        opacity:1;
        transform:none;
    }

}

</style>
</head>

<body>

<!-- TOP BAR -->

<div class="topbar">
    <div class="container topbar-inner">

        <span>Construction. Development. Built Environment.</span>

        <div class="topbar-right">
            <span>Serving the Midlands</span>
            <span>Monday – Friday | 08:00 – 17:00</span>
        </div>

    </div>
</div>

<!-- NAVIGATION -->

<header>
    <div class="container nav-inner">

        <a href="#" class="brand" aria-label="Alderstone Construction home">

            <svg class="brand-icon" viewBox="0 0 48 48" fill="none">
                <path d="M3 42L24 4L45 42H34L24 22L14 42H3Z" fill="currentColor"/>
                <path d="M18 42L24 31L30 42H18Z" fill="currentColor"/>
            </svg>

            <div class="brand-name">
                ALDERSTONE
                <small>CONSTRUCTION</small>
            </div>

        </a>

        <button
            class="menu-toggle"
            id="menuToggle"
            aria-label="Open navigation"
            aria-expanded="false"
            aria-controls="navigation"
            type="button">
            ☰
        </button>

        <nav id="navigation">

            <a href="#">Home</a>
            <a href="#services">Our Services</a>
            <a href="#about">About Us</a>
            <a href="#projects">Our Projects</a>
            <a href="#process">Our Approach</a>
            <a href="#contact">Contact</a>

        </nav>

        <a href="#contact" class="btn btn-primary">
            Get a Quote <span>↗</span>
        </a>

    </div>
</header>

<main>

<!-- HERO -->

<section class="hero">

    <div class="container">

        <div class="hero-content">

            <div class="eyebrow">
                Building beyond expectations
            </div>

            <h1>
                Built for<br>
                <span>tomorrow.</span>
