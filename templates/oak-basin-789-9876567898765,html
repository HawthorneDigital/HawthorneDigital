<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#222622">

<title>Oak & Basin 789 | Kitchens & Bathrooms</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root {
    --dark: #222622;
    --black: #171A17;
    --gold: #D5B98D;
    --cream: #F5F2EC;
    --white: #FFFFFF;
    --text: #30352F;
    --muted: #71766F;
    --border: #DDDCD5;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
}

body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.7;
}

a {
    color: inherit;
    text-decoration: none;
}

button, input, textarea, select {
    font: inherit;
}

button {
    cursor: pointer;
}

img {
    display: block;
    width: 100%;
}

h1, h2, h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 500;
    line-height: 1.15;
    margin: 0 0 22px;
}

h1 {
    font-size: clamp(48px, 6.5vw, 94px);
    letter-spacing: -2.5px;
}

h2 {
    font-size: clamp(34px, 4vw, 58px);
    letter-spacing: -1.5px;
}

h3 {
    font-size: 30px;
}

p {
    margin: 0 0 20px;
}

.container {
    width: min(1240px, calc(100% - 80px));
    margin: auto;
}

.section {
    padding: 110px 0;
}

.eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    padding: 17px 27px;
    min-height: 55px;
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 600;
    transition: background .25s, color .25s;
}

.button-gold {
    background: var(--gold);
    color: var(--dark);
}

.button-gold:hover {
    background: #E9D5B6;
}

.button-dark {
    background: var(--dark);
    color: white;
}

.button-dark:hover {
    background: #414A40;
}

.button-outline {
    border-color: rgba(255,255,255,.5);
    color: white;
}

.button-outline:hover {
    background: white;
    color: var(--dark);
}

/* HEADER */

.topbar {
    background: var(--black);
    color: #C5C9C3;
    font-size: 11px;
    padding: 9px 0;
}

.topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--dark);
    color: white;
    border-bottom: 1px solid rgba(255,255,255,.1);
}

.navigation {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    flex-shrink: 0;
}

.logo img {
    width: 230px;
    height: 65px;
    object-fit: contain;
    object-position: left center;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 29px;
}

.nav-links a {
    font-size: 13px;
    font-weight: 500;
    transition: color .2s;
}

.nav-links a:hover {
    color: var(--gold);
}

.nav-links .nav-cta {
    background: var(--gold);
    color: var(--dark);
    padding: 13px 20px;
}

.nav-links .nav-cta:hover {
    background: #E9D5B6;
    color: var(--dark);
}

.menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    padding: 10px;
}

.menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    margin: 6px 0;
    background: white;
}

/* HERO */

.hero {
    position: relative;
    min-height: 680px;
    display: flex;
    align-items: center;
    color: white;
    background:
        linear-gradient(
            90deg,
            rgba(20,24,20,.83) 0%,
            rgba(20,24,20,.52) 48%,
            rgba(20,24,20,.12) 100%
        ),
        url('https://images.unsplash.com/photo-1556912172-45b7abe8b7e1?auto=format&fit=crop&w=2200&q=85')
        center center / cover no-repeat;
    background-color: var(--dark);
}

.hero-content {
    max-width: 760px;
    padding: 100px 0 130px;
}

.hero .eyebrow {
    color: var(--gold);
}

.hero h1 em {
    color: var(--gold);
    font-weight: 400;
}

.hero p {
    max-width: 510px;
    font-size: 17px;
    color: #E0E2DD;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.hero-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,.2);
}

.hero-bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 12px;
    color: #E0E2DD;
}

/* INTRODUCTION */

.introduction {
    background: var(--cream);
}

.intro-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 100px;
    align-items: center;
}

.introduction .eyebrow {
    color: #806B49;
}

.intro-copy {
    color: var(--muted);
    font-size: 16px;
}

.text-link {
    display: inline-flex;
    gap: 30px;
    align-items: center;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-size: 13px;
    font-weight: 700;
}

/* SERVICES */

.services {
    background: white;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
    margin-bottom: 50px;
}

.section-heading h2 {
    margin-bottom: 0;
}

.section-heading p {
    max-width: 390px;
    color: var(--muted);
    font-size: 14px;
    margin: 0;
}

.services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.service-image {
    position: relative;
    overflow: hidden;
    background: #DDDCD5;
}

.service-image img {
    height: 430px;
    object-fit: cover;
    transition: transform .7s;
}

.service:hover img {
    transform: scale(1.04);
}

.image-label {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: var(--cream);
    padding: 10px 17px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.service-content {
    padding: 28px 0 10px;
}

.service-content h3 {
    font-size: 36px;
}

.service-content p {
    max-width: 480px;
    font-size: 14px;
    color: var(--muted);
}

/* CAPABILITIES */

.capabilities {
    background: var(--dark);
    color: white;
    padding: 36px 0;
}

.capabilities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.capability {
    padding: 12px 25px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.16);
}

.capability:last-child {
    border: 0;
}

.capability svg {
    width: 30px;
    height: 30px;
    color: var(--gold);
    margin-bottom: 10px;
}

.capability strong {
    display: block;
    font-size: 13px;
    font-weight: 500;
}

/* ABOUT */

.about {
    background: var(--cream);
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr .85fr;
    align-items: center;
    gap: 85px;
}

.about-image {
    position: relative;
}

.about-image img {
    height: 570px;
    object-fit: cover;
}

.about-caption {
    position: absolute;
    right: -20px;
    bottom: 25px;
    background: var(--dark);
    color: white;
    padding: 25px 35px;
    max-width: 250px;
}

.about-caption strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    color: var(--gold);
}

.about-caption span {
    font-size: 12px;
}

.about-copy p {
    color: var(--muted);
    font-size: 15px;
}

.about-list {
    margin: 28px 0 35px;
}

.about-list div {
    display: flex;
    gap: 15px;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding: 15px 0;
    font-size: 14px;
}

.about-list span {
    color: #806B49;
}

/* INSPIRATION GALLERY */

.gallery {
    background: white;
}

.gallery-heading {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
}

.gallery-heading p {
    color: var(--muted);
    font-size: 14px;
}

.gallery-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-bottom: 35px;
}

.gallery-filter {
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 10px 5px;
    color: var(--muted);
    font-size: 13px;
}

.gallery-filter.active {
    color: var(--dark);
    border-color: #A88B60;
    font-weight: 700;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    background: var(--cream);
}

.gallery-item[hidden] {
    display: none;
}

.gallery-item img {
    height: 330px;
    object-fit: cover;
    transition: transform .6s;
}

.gallery-item:hover img {
    transform: scale(1.05);
}

.gallery-caption {
    padding: 18px 20px;
}

.gallery-caption strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    font-size: 22px;
}

.gallery-caption span {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* PROCESS */

.process {
    background: var(--cream);
}

.process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-top: 55px;
}

.process-step {
    padding-top: 25px;
    border-top: 1px solid #B9B6AC;
}

.step-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    color: #A88B60;
    line-height: 1;
}

.process-step h3 {
    font-size: 25px;
    margin: 24px 0 14px;
}

.process-step p {
    font-size: 13px;
    color: var(--muted);
}

/* FULL WIDTH IMAGE */

.feature {
    min-height: 460px;
    display: flex;
    align-items: center;
    text-align: center;
    color: white;
    background:
        linear-gradient(
            rgba(20,24,20,.57),
            rgba(20,24,20,.57)
        ),
        url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85')
        center / cover no-repeat;
    background-color: var(--dark);
}

.feature-content {
    max-width: 740px;
    margin: auto;
    padding: 80px 0;
}

.feature .eyebrow {
    color: var(--gold);
}

.feature p {
    color: #E1E3DF;
    margin-bottom: 30px;
}

/* FAQ */

.faq {
    background: white;
}

.faq-grid {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    gap: 90px;
}

.faq-intro p {
    color: var(--muted);
    font-size: 14px;
}

details {
    border-bottom: 1px solid var(--border);
}

details:first-child {
    border-top: 1px solid var(--border);
}

summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
}

summary::-webkit-details-marker {
    display: none;
}

summary::after {
    content: '+';
    font-size: 24px;
    font-weight: 400;
    color: #806B49;
}

details[open] summary::after {
    content: '−';
}

details p {
    padding: 0 30px 20px 0;
    color: var(--muted);
    font-size: 14px;
}

/* CONTACT */

.contact {
    background: var(--dark);
    color: white;
}

.contact-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 100px;
}

.contact .eyebrow {
    color: var(--gold);
}

.contact-copy p {
    color: #BDC3BB;
    font-size: 15px;
    max-width: 420px;
}

.contact-details {
    margin-top: 40px;
    border-top: 1px solid rgba(255,255,255,.18);
}

.contact-detail {
    padding: 20px 0;
    border-bottom: 1px solid rgba(255,255,255,.18);
}

.contact-detail small {
    display: block;
    color: var(--gold);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

.contact-detail a,
.contact-detail span {
    font-size: 14px;
    overflow-wrap: anywhere;
}

.enquiry-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
}

.form-field {
    min-width: 0;
}

.form-field.full {
    grid-column: 1 / -1;
}

.enquiry-form label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
}

.enquiry-form input,
.enquiry-form select,
.enquiry-form textarea {
    width: 100%;
    background: #2C312C;
    border: 1px solid #535B52;
    border-radius: 0;
    padding: 15px;
    color: white;
    font-size: 14px;
    outline: none;
}

.enquiry-form input:focus,
.enquiry-form select:focus,
.enquiry-form textarea:focus {
    border-color: var(--gold);
}

.enquiry-form input::placeholder,
.enquiry-form textarea::placeholder {
    color: #A8AFA6;
}

.enquiry-form textarea {
    min-height: 140px;
    resize: vertical;
}

.enquiry-form button {
    width: 100%;
}

.form-note {
    font-size: 11px;
    color: #B6BEB4;
    margin: 0;
}

#formMessage {
    color: var(--gold);
    font-size: 13px;
}

/* FOOTER */

.footer {
    background: var(--black);
    color: white;
    padding: 65px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr;
    gap: 70px;
}

.footer-logo {
    width: 245px;
    height: auto;
    object-fit: contain;
}

.footer-brand p {
    max-width: 330px;
    color: #AEB5AC;
    font-size: 13px;
    margin-top: 25px;
}

.footer h4 {
    margin: 0 0 20px;
    font-size: 14px;
    font-weight: 600;
}

.footer-links a {
    display: block;
    margin-bottom: 12px;
    font-size: 13px;
    color: #AEB5AC;
}

.footer-links a:hover {
    color: var(--gold);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid rgba(255,255,255,.12);
    margin-top: 45px;
    padding-top: 22px;
    font-size: 11px;
    color: #AEB5AC;
}

:focus-visible {
    outline: 2px solid #B6986B;
    outline-offset: 4px;
}

/* RESPONSIVE */

@media (max-width: 1100px) {
    .nav-links {
        gap: 18px;
    }

    .logo img {
        width: 190px;
    }

    .intro-grid,
    .about-grid,
    .contact-grid,
    .faq-grid {
        gap: 45px;
    }

    .gallery-item img {
        height: 270px;
    }
}

@media (max-width: 900px) {
    .container {
        width: calc(100% - 44px);
    }

    .section {
        padding: 75px 0;
    }

    .navigation {
        min-height: 80px;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--dark);
        padding: 20px 22px 30px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        border-top: 1px solid #444C43;
    }

    .nav-links.active {
        display: flex;
    }

    .nav-links a {
        padding: 13px 0;
    }

    .nav-links .nav-cta {
        text-align: center;
        margin-top: 15px;
    }

    .hero {
        min-height: 600px;
    }

    .intro-grid,
    .about-grid,
    .contact-grid,
    .faq-grid {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
        gap: 15px;
    }

    .service-image img {
        height: 300px;
    }

    .about-image img {
        height: 430px;
    }

    .about-caption {
        right: 0;
    }

    .gallery-grid,
    .process-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 35px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }
}

@media (max-width: 600px) {
    .container {
        width: calc(100% - 36px);
    }

    .section {
        padding: 60px 0;
    }

    h1 {
        letter-spacing: -1.5px;
    }

    .topbar-inner {
        justify-content: center;
        text-align: center;
    }

    .topbar-inner a {
        display: none;
    }

    .hero {
        min-height: 630px;
        background-position: 60% center;
    }

    .hero-content {
        padding: 75px 0 110px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-bottom-inner {
        justify-content: center;
        text-align: center;
    }

    .hero-bottom-inner span:last-child {
        display: none;
    }

    .services-grid,
    .gallery-grid,
    .process-grid,
    .enquiry-form,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .service-image img {
        height: 310px;
    }

    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
        row-gap: 25px;
    }

    .capability:nth-child(2) {
        border: 0;
    }

    .about-image img {
        height: 380px;
    }

    .about-caption {
        padding: 18px 22px;
    }

    .gallery-item img {
        height: 320px;
    }

    .gallery-filters {
        gap: 15px;
    }

    .process-grid {
        gap: 20px;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 10px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *, *::before, *::after {
        transition: none !important;
        animation: none !important;
    }
}
</style>
</head>

<body>

<!-- TOP BAR -->

<div class="topbar">
    <div class="container topbar-inner">
        <span>Kitchen & bathroom design and installation</span>

        <a href="#contact">
            Discuss your next project
        </a>
    </div>
</div>

<!-- NAVIGATION -->

<header class="site-header">
    <div class="container navigation">

        <a href="#" class="logo" aria-label="Oak and Basin 789 home">
            <img
                src="Oak-Basin-789-logo.png"
                alt="Oak & Basin 789 Kitchens and Bathrooms">
        </a>

        <button
            class="menu-toggle"
            type="button"
            aria-label="Open navigation"
            aria-expanded="false"
            aria-controls="navigationLinks">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="nav-links" id="navigationLinks">
            <a href="#">Home</a>
            <a href="#kitchens">Kitchens</a>
            <a href="#bathrooms">Bathrooms</a>
            <a href="#about">About Us</a>
            <a href="#inspiration">Inspiration</a>
            <a href="#contact" class="nav-cta">
                Get a Quote →
            </a>
        </nav>

    </div>
</header>

<main>

<!-- HERO -->

<section class="hero">

    <div class="container">

        <div class="hero-content">

            <span class="eyebrow">
                Designed for everyday living
            </span>

            <h1>
                Beautiful spaces.<br>
                <em>Better living.</em>
            </h1>

            <p>
                Thoughtfully designed kitchens and bathrooms,
                professionally fitted around your home,
                your lifestyle and the way you live.
            </p>

            <div class="hero-buttons">

                <a href="#contact" class="button button-gold">
                    Discuss Your Project →
                </a>

                <a href="#services" class="button button-outline">
                    Explore Our Services
                </a>

            </div>

        </div>

    </div>

    <div class="hero-bottom">
        <div class="container hero-bottom-inner">

            <span>
                Design. Preparation. Installation. Finishing.
            </span>

            <span>
                Kitchens & Bathrooms / Oak & Basin 789
            </span>

        </div>
    </div>

</section>

<!-- INTRODUCTION -->

<section class="section introduction">

    <div class="container intro-grid">

        <div>

            <span class="eyebrow">
                Welcome to Oak & Basin 789
            </span>

            <h2>
                Your home deserves<br>
                something exceptional.
            </h2>

        </div>

        <div class="intro-copy">

            <p>
